{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "Unit_Description.schema.json",
  "title": "Unit Description",
  "type": "object",
  "additionalProperties": true,
  "properties": {
    "project": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "current_registry_project_id": {
          "type": "string",
          "description": "Identifier used to track the project in the current registry.",
          "x-cdop-field-id": 139,
          "x-cdop-pre-issuance-inclusion": "No",
          "x-cdop-cardinality": "1..1",
          "x-cdop-data-source": "Registry",
          "x-cdop-mutability": "mutable",
          "x-cdop-public-private": "Public",
          "x-cdop-schema": "CDOP",
          "x-cdop-field-path": "project.current_registry_project_id"
        }
      },
      "required": [
        "current_registry_project_id"
      ]
    },
    "unit": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "descriptor": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": true,
            "properties": {
              "metric": {
                "type": "string",
                "description": "Unit of measurment for quantifying the reduction or removal",
                "x-cdop-field-id": 140,
                "x-cdop-pre-issuance-inclusion": "No",
                "x-cdop-cardinality": "1..1",
                "x-cdop-data-source": "Project developer",
                "x-cdop-mutability": "Immutable",
                "x-cdop-public-private": "Public",
                "x-cdop-schema": "CDOP",
                "x-cdop-field-path": "unit.descriptor[].metric"
              },
              "type": {
                "type": "string",
                "description": "Describes the type of unit.",
                "x-cdop-field-id": 149,
                "x-cdop-pre-issuance-inclusion": "No",
                "x-cdop-cardinality": "1..1",
                "x-cdop-data-source": "Project developer",
                "x-cdop-mutability": "Immutable",
                "x-cdop-public-private": "Public",
                "x-cdop-schema": "CDOP",
                "x-cdop-field-path": "unit.descriptor[].type"
              }
            },
            "required": [
              "metric",
              "type"
            ]
          }
        },
        "owner_account_id": {
          "type": "string",
          "description": "identifier for the owner of the unit",
          "x-cdop-field-id": 141,
          "x-cdop-pre-issuance-inclusion": "No",
          "x-cdop-cardinality": "1..1",
          "x-cdop-mutability": "mutable",
          "x-cdop-public-private": "Private",
          "x-cdop-schema": "CDOP",
          "x-cdop-field-path": "unit.owner_account_id"
        },
        "retirement": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": true,
            "properties": {
              "retirement_beneficiary": {
                "type": "string",
                "description": "Entity name on behalf of which the retirement occurred",
                "x-cdop-field-id": 142,
                "x-cdop-pre-issuance-inclusion": "No",
                "x-cdop-cardinality": "0..1",
                "x-cdop-mutability": "mutable",
                "x-cdop-public-private": "Public",
                "x-cdop-schema": "CDOP",
                "x-cdop-field-path": "unit.retirement[].retirement_beneficiary"
              },
              "retirement_detail": {
                "type": "string",
                "description": "Additional context describing the retirements",
                "x-cdop-field-id": 143,
                "x-cdop-pre-issuance-inclusion": "No",
                "x-cdop-cardinality": "0..1",
                "x-cdop-mutability": "mutable",
                "x-cdop-public-private": "Public",
                "x-cdop-schema": "CDOP",
                "x-cdop-field-path": "unit.retirement[].retirement_detail"
              }
            },
            "required": []
          }
        },
        "reference": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": true,
            "properties": {
              "serial_number": {
                "type": "string",
                "description": "Serial number of the unit",
                "x-cdop-field-id": 144,
                "x-cdop-pre-issuance-inclusion": "No",
                "x-cdop-cardinality": "1..1",
                "x-cdop-mutability": "Immutable",
                "x-cdop-public-private": "Public",
                "x-cdop-schema": "CDOP",
                "x-cdop-field-path": "unit.reference[].serial_number"
              },
              "source_serial_number": {
                "type": "string",
                "description": "Identifier used to track the unit to the original issuance it was part of.",
                "x-cdop-field-id": 145,
                "x-cdop-pre-issuance-inclusion": "No",
                "x-cdop-cardinality": "0..1",
                "x-cdop-mutability": "Immutable",
                "x-cdop-public-private": "Public",
                "x-cdop-schema": "CDOP",
                "x-cdop-field-path": "unit.reference[].source_serial_number"
              }
            },
            "required": [
              "serial_number"
            ]
          }
        },
        "status": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": true,
            "properties": {
              "status": {
                "type": "string",
                "description": "The current status of the unit",
                "x-cdop-field-id": 146,
                "x-cdop-pre-issuance-inclusion": "No",
                "x-cdop-cardinality": "1..1",
                "x-cdop-mutability": "mutable",
                "x-cdop-public-private": "Public",
                "x-cdop-schema": "CDOP",
                "x-cdop-field-path": "unit.status[].status"
              },
              "status_reason": {
                "type": "string",
                "description": "The reason for updating the unit status",
                "x-cdop-field-id": 147,
                "x-cdop-pre-issuance-inclusion": "No",
                "x-cdop-cardinality": "0..1",
                "x-cdop-data-source": "User Input",
                "x-cdop-mutability": "mutable",
                "x-cdop-public-private": "Private",
                "x-cdop-schema": "CDOP",
                "x-cdop-field-path": "unit.status[].status_reason"
              },
              "is_current": {
                "type": "boolean",
                "description": "False for previous statuses, True for the current status.",
                "x-cdop-field-id": 148,
                "x-cdop-pre-issuance-inclusion": "No",
                "x-cdop-cardinality": "0..1",
                "x-cdop-mutability": "Mutable",
                "x-cdop-public-private": "Public",
                "x-cdop-schema": "CDOP",
                "x-cdop-field-path": "unit.status[].is_current"
              }
            },
            "required": [
              "is_current",
              "status"
            ]
          }
        },
        "credit_block": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": true,
            "properties": {
              "quantity": {
                "type": "integer",
                "description": "Quantity of units included in the credit block that a particular record represents",
                "x-cdop-field-id": 150,
                "x-cdop-pre-issuance-inclusion": "No",
                "x-cdop-cardinality": "1..1",
                "x-cdop-mutability": "mutable",
                "x-cdop-public-private": "Public",
                "x-cdop-schema": "CDOP",
                "x-cdop-field-path": "unit.credit_block[].quantity"
              },
              "block_end": {
                "type": "integer",
                "description": "Number indicating the last unit within a credit block",
                "x-cdop-field-id": 151,
                "x-cdop-pre-issuance-inclusion": "No",
                "x-cdop-cardinality": "1..1",
                "x-cdop-data-source": "Carbon Crediting Program/ Standard Setters",
                "x-cdop-mutability": "mutable",
                "x-cdop-public-private": "Public",
                "x-cdop-schema": "CDOP",
                "x-cdop-field-path": "unit.credit_block[].block_end"
              },
              "block_start": {
                "type": "integer",
                "description": "Number indicating the first unit within a credit block",
                "x-cdop-field-id": 152,
                "x-cdop-pre-issuance-inclusion": "No",
                "x-cdop-cardinality": "1..1",
                "x-cdop-data-source": "Carbon Crediting Program/ Standard Setters",
                "x-cdop-mutability": "mutable",
                "x-cdop-public-private": "Public",
                "x-cdop-schema": "CDOP",
                "x-cdop-field-path": "unit.credit_block[].block_start"
              }
            },
            "required": [
              "block_end",
              "block_start",
              "quantity"
            ]
          }
        }
      },
      "required": [
        "owner_account_id"
      ]
    },
    "vintage": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "vintage": {
          "type": "string",
          "format": "date",
          "description": "Temporal period when the envrionmental benefit occurred",
          "x-cdop-field-id": 153,
          "x-cdop-pre-issuance-inclusion": "No",
          "x-cdop-cardinality": "1..1",
          "x-cdop-data-source": "Project developer",
          "x-cdop-mutability": "Immutable",
          "x-cdop-public-private": "Public",
          "x-cdop-schema": "CDOP",
          "x-cdop-field-path": "vintage.vintage"
        }
      },
      "required": [
        "vintage"
      ]
    }
  },
  "required": [
    "project",
    "unit",
    "vintage"
  ]
}