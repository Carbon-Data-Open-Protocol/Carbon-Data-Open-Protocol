{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "Verification_Metadata.schema.json",
  "title": "Verification_Metadata",
  "type": "object",
  "additionalProperties": true,
  "properties": {
    "verification": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "identification": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": true,
            "properties": {
              "verification_id": {
                "type": "string",
                "description": "A globally unique identifier for the specific verification event or claim.",
                "x-cdop-field-id": 307,
                "x-cdop-cardinality": "1..1",
                "x-cdop-field-path": "verification.identification[].verification_id"
              },
              "verification_claim_type": {
                "type": "string",
                "description": "The classification of the claim being verified (e.g., CARBON_REMOVAL, EMISSION_REDUCTION, BIODIVERSITY).",
                "x-cdop-field-id": 308,
                "x-cdop-cardinality": "1..1",
                "x-cdop-field-path": "verification.identification[].verification_claim_type"
              },
              "verification_project_id": {
                "type": "string",
                "description": "The unique ID of the underlying project registered on the host registry.",
                "x-cdop-field-id": 309,
                "x-cdop-cardinality": "1..1",
                "x-cdop-field-path": "verification.identification[].verification_project_id"
              },
              "verification_description": {
                "type": "string",
                "description": "A concise, human-readable summary of the verification scope and findings.",
                "x-cdop-field-id": 310,
                "x-cdop-cardinality": "1..1",
                "x-cdop-field-path": "verification.identification[].verification_description"
              }
            },
            "required": [
              "verification_claim_type",
              "verification_description",
              "verification_id",
              "verification_project_id"
            ]
          }
        },
        "reporting": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": true,
            "properties": {
              "verification_reporting_period_start": {
                "type": "string",
                "format": "date",
                "description": "The start date of the monitoring/reporting period being verified.",
                "x-cdop-field-id": 311,
                "x-cdop-cardinality": "1..1",
                "x-cdop-field-path": "verification.reporting[].verification_reporting_period_start"
              },
              "verification_reporting_period_end": {
                "type": "string",
                "format": "date",
                "description": "The end date of the monitoring/reporting period being verified.",
                "x-cdop-field-id": 312,
                "x-cdop-cardinality": "1..1",
                "x-cdop-field-path": "verification.reporting[].verification_reporting_period_end"
              },
              "verification_date": {
                "type": "string",
                "format": "date",
                "description": "The official date the verification process was completed and signed off.",
                "x-cdop-field-id": 313,
                "x-cdop-cardinality": "1..1",
                "x-cdop-field-path": "verification.reporting[].verification_date"
              }
            },
            "required": [
              "verification_date",
              "verification_reporting_period_end",
              "verification_reporting_period_start"
            ]
          }
        },
        "quantity": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": true,
            "properties": {
              "verified_quantity": {
                "type": "number",
                "description": "The final, audited, and verified net volume for this specific reporting period.",
                "x-cdop-field-id": 314,
                "x-cdop-cardinality": "1..1",
                "x-cdop-field-path": "verification.quantity[].verified_quantity"
              },
              "verification_quantity_uom": {
                "type": "string",
                "description": "The Unit of Measure for the verified quantity (e.g., tCO2e, m3_biogas).",
                "x-cdop-field-id": 315,
                "x-cdop-cardinality": "1..1",
                "x-cdop-field-path": "verification.quantity[].verification_quantity_uom"
              }
            },
            "required": [
              "verification_quantity_uom",
              "verified_quantity"
            ]
          }
        },
        "body": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": true,
            "properties": {
              "verification_body_name": {
                "type": "string",
                "description": "The official name of the third-party auditing entity/VVB.",
                "x-cdop-field-id": 316,
                "x-cdop-cardinality": "1..1",
                "x-cdop-field-path": "verification.body[].verification_body_name"
              },
              "verification_body_id": {
                "type": "string",
                "description": "The decentralized identifier (DID) or registry ID of the verification body.",
                "x-cdop-field-id": 317,
                "x-cdop-cardinality": "1..1",
                "x-cdop-field-path": "verification.body[].verification_body_id"
              }
            },
            "required": [
              "verification_body_id",
              "verification_body_name"
            ]
          }
        },
        "standard": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": true,
            "properties": {
              "verification_applied_standard": {
                "type": "string",
                "description": "The overarching registry framework (e.g., Verra_VCS_v4.5, Gold_Standard).",
                "x-cdop-field-id": 318,
                "x-cdop-cardinality": "1..1",
                "x-cdop-field-path": "verification.standard[].verification_applied_standard"
              },
              "verification_applied_methodology_protocol": {
                "type": "string",
                "description": "The specific methodology version applied (e.g., VM0047_v1.0, CAR_Soil_v1.1).",
                "x-cdop-field-id": 319,
                "x-cdop-cardinality": "0..1",
                "x-cdop-field-path": "verification.standard[].verification_applied_methodology_protocol"
              }
            },
            "required": [
              "verification_applied_standard"
            ]
          }
        },
        "verification_report_url": {
          "type": "array",
          "items": {
            "type": "string",
            "description": "The direct, secure hyperlink to the official public verification report PDF.",
            "x-cdop-field-id": 320,
            "x-cdop-cardinality": "1..*",
            "x-cdop-field-path": "verification.verification_report_url"
          },
          "minItems": 1
        },
        "verification_credential_issuer_id": {
          "type": "string",
          "description": "The decentralized identifier (DID) of the entity issuing the digital verification token.",
          "x-cdop-field-id": 321,
          "x-cdop-cardinality": "1..1",
          "x-cdop-field-path": "verification.verification_credential_issuer_id"
        },
        "verification_cryptographic_proof_type": {
          "type": "string",
          "description": "The security protocol used (e.g., Ed25519Signature2020, JSON-LD).",
          "x-cdop-field-id": 322,
          "x-cdop-cardinality": "0..1",
          "x-cdop-field-path": "verification.verification_cryptographic_proof_type"
        },
        "verification_digital_signature_payload": {
          "type": "string",
          "description": "The actual cryptographic signature, payload hash, or verifiable presentation metadata.",
          "x-cdop-field-id": 323,
          "x-cdop-cardinality": "0..1",
          "x-cdop-field-path": "verification.verification_digital_signature_payload"
        },
        "leakage": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": true,
            "properties": {
              "verification_leakage_risk_mitigation": {
                "type": "boolean",
                "description": "Indicates if leakage risk is accounted for on this verification event",
                "x-cdop-field-id": 324,
                "x-cdop-cardinality": "0..1",
                "x-cdop-field-path": "verification.leakage[].verification_leakage_risk_mitigation"
              },
              "verification_leakage_risk_mitigation_strategy": {
                "type": "string",
                "description": "links to or summarizes the mitigation strategy for this verification event",
                "x-cdop-field-id": 325,
                "x-cdop-cardinality": "0..1",
                "x-cdop-field-path": "verification.leakage[].verification_leakage_risk_mitigation_strategy"
              },
              "verification_leakage_deduction_quantity": {
                "type": "number",
                "description": "Volume deducted for this specific reporting period to account for leakage.",
                "x-cdop-field-id": 326,
                "x-cdop-cardinality": "0..1",
                "x-cdop-field-path": "verification.leakage[].verification_leakage_deduction_quantity"
              }
            },
            "required": []
          }
        },
        "verification_uncertainty_deduction_margin": {
          "type": "number",
          "description": "Percentage or absolute deduction applied for this specific reporting period for uncertainty.",
          "x-cdop-field-id": 327,
          "x-cdop-cardinality": "0..1",
          "x-cdop-field-path": "verification.verification_uncertainty_deduction_margin"
        },
        "verification_buffer_pool_deduction_quantity": {
          "type": "number",
          "description": "Volume deducted for this specific reporting period and contributed to the buffer pool.",
          "x-cdop-field-id": 328,
          "x-cdop-cardinality": "0..1",
          "x-cdop-field-path": "verification.verification_buffer_pool_deduction_quantity"
        },
        "verification_audit_checkpoint_status": {
          "type": "string",
          "description": "Summary result of the checklist (e.g., PASS, PASS_WITH_RESERVATIONS, FAIL).",
          "x-cdop-field-id": 329,
          "x-cdop-cardinality": "0..1",
          "x-cdop-field-path": "verification.verification_audit_checkpoint_status"
        }
      },
      "required": [
        "verification_credential_issuer_id",
        "verification_report_url"
      ]
    }
  },
  "required": [
    "verification"
  ]
}