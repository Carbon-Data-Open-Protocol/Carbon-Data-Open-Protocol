                "x-cdop-schema": "CDOP",
                "x-cdop-field-path": "project_registry_history.registrations[].registry_identifier"
              },
              "registry_name": {
                "type": "string",
                "description": "Name of the registry on which the project is / was registered, from the CDOP controlled registry list.",
                "enum": [
                  "American Carbon Registry (ACR)",
                  "ART Registry",
                  "Biocarbon Registry (BCR)",
                  "Carbon Assets Trading System (CATS)",
                  "CDM Registry",
