{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "Registry_Metadata.schema.json",
  "title": "Registry_Metadata",
  "type": "object",
  "additionalProperties": true,
  "properties": {
    "project_registry_history": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "project_identifier": {
          "type": "string",
          "description": "CDOP project identifier of the project this registry history describes. Join key to the Project entity (same value as project.project_identifier).",
          "x-cdop-field-id": 261,
          "x-cdop-pre-issuance-inclusion": "Yes",
          "x-cdop-cardinality": "1..1",
          "x-cdop-data-source": "registry",
          "x-cdop-mutability": "Immutable",
          "x-cdop-public-private": "Public",
          "x-cdop-schema": "CDOP",
          "x-cdop-field-path": "project_registry_history.project_identifier"
        },
        "last_updated_at": {
          "type": "string",
          "format": "date-time",
          "description": "Timestamp of the last modification of the source registry record for this project (not of the CDOP payload). Intended to be usable as a synchronisation watermark for incremental (delta) exports.",
