                  "Climate Action Reserve (CAR)",
                  "Costa Rica National Registry",
                  "Covalent Registry",
                  "Cultivo",
                  "EcoRegistry",
                  "Equitable Earth",
                  "Global Carbon Council (GCC)",
                  "Global Carbon Market Utility (GCMU)",
                  "Gold Standard",
                  "Isometric",
                  "Joint Crediting Mechanism",
                  "Mexico National Registry",
                  "MoorFutures",
                  "Natural Forest Standard (NFS) Registry",
                  "Open Carbon Protocol",
                  "Open Earth Foundation",
                  "PACM Registry",
                  "Pakistan National Registry",
                  "Plan Vivo",
                  "Puro Standard and Registry",
                  "Registry of China Certified Emission Reduction Trading System",
                  "Riverse",
                  "Royal Kingdom of Bhutan",
                  "Singapore National Registry",
                  "Sweden National Registry",
