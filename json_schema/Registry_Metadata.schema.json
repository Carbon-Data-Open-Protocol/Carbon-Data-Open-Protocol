              "status_reason": {
                "type": "string",
                "description": "Reason for a transfer, withdrawal or rejection on this registry.",
                "x-cdop-field-id": 271,
                "x-cdop-pre-issuance-inclusion": "Yes",
                "x-cdop-cardinality": "0..1",
                "x-cdop-data-source": "registry",
                "x-cdop-mutability": "Mutable",
                "x-cdop-public-private": "Public",
                "x-cdop-schema": "CDOP",
                "x-cdop-field-path": "project_registry_history.status[].status_reason"
              },
              "is_current": {
                "type": "boolean",
                "description": "False for previous statuses, True for the current status.",
                "x-cdop-field-id": 272,
                "x-cdop-pre-issuance-inclusion": "Yes",
                "x-cdop-cardinality": "0..1",
                "x-cdop-data-source": "registry",
                "x-cdop-mutability": "Mutable",
                "x-cdop-public-private": "Public",
                "x-cdop-schema": "CDOP",
                "x-cdop-field-path": "project_registry_history.status[].is_current"
              }
            },
            "required": []
          }
        }
